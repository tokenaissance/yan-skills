{
  "name": "backlink",
  "version": "3.1.0",
  "owner": "Yan",
  "updated_at": "2026-08-22",
  "status": "active",
  "maturity_tier": "production",
  "lifecycle_stage": "active",
  "context_budget_tier": "production",
  "review_cadence": "quarterly",
  "upstream_inspiration": "https://github.com/flaqai/backlink_skills; https://github.com/aaron-he-zhu/seo-geo-claude-skills",
  "intent": {
    "job_to_be_done": "Complete the backlink lifecycle: discover backlink opportunities, qualify them, safely fill verified forms with the owner's logged-in Chrome, submit only after explicit human approval, verify outcomes with evidence, and harvest tables from logged-in dashboards that have no API.",
    "target_users": [
      "indie hackers",
      "SEO operators",
      "solo site builders"
    ],
    "inputs": [
      "target URL or domain",
      "competitor domains",
      "exported backlink CSVs",
      "dashboard sessions"
    ],
    "outputs": [
      "qualified opportunity queue",
      "safe-fill review payloads",
      "ledger states (candidate → … → rel_verified)",
      "harvested report tables"
    ],
    "exclusions": [
      "unverified directory lists",
      "auto-submitting without approval",
      "guessing publication from a confirmation notice"
    ],
    "defaults": {
      "browser_rule": "owner's logged-in Chrome via OpenCLI only",
      "submission_gate": "release-submit-guard; human approval per submission",
      "ledger_chain": "candidate → qualified → filled → submitted → public → indexed@<engine> → rel_verified"
    }
  },
  "release_gates": [
    "validate_skill",
    "trigger_eval",
    "skill_ir_export",
    "version_consistency",
    "bilingual_readme",
    "evidence_reports",
    "upstream_credit",
    "data_validation",
    "evidence_rule"
  ]
}
