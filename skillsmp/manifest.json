{
  "name": "skillsmp",
  "version": "1.0.0",
  "owner": "Yan",
  "updated_at": "2026-08-22",
  "status": "active",
  "maturity_tier": "production",
  "lifecycle_stage": "active",
  "context_budget_tier": "production",
  "review_cadence": "quarterly",
  "upstream_inspiration": "https://skillsmp.com",
  "intent": {
    "job_to_be_done": "Search SkillsMP (a 1.6M+ public SKILL.md index covering Claude Code / Codex / ChatGPT) for agent skills by keyword, category, profession, or language, and deliberately surface well-written but under-known skills. Use it to see what already exists in a domain and avoid reinventing the wheel before writing a new skill.",
    "target_users": [
      "skill authors",
      "engineers looking for an existing skill"
    ],
    "inputs": [
      "keyword or domain",
      "category / profession / language filters"
    ],
    "outputs": [
      "ranked skill results",
      "hidden-gem (treasure) results",
      "JSON output for automation"
    ],
    "exclusions": [
      "skill execution or installation",
      "web search outside SkillsMP"
    ],
    "defaults": {
      "anonymous_quota": "50 requests/day, 10/min",
      "with_key_quota": "500 requests/day",
      "treasure_mode": "deliberately not sorted by stars"
    }
  },
  "release_gates": [
    "validate_skill",
    "trigger_eval",
    "skill_ir_export",
    "version_consistency",
    "bilingual_readme",
    "evidence_reports",
    "upstream_credit"
  ]
}
